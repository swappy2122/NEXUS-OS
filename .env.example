# NEXUS OS Environment Configuration

NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO
NEXUS_DATA_DIR=./data
NEXUS_ENABLE_SECURITY=true
NEXUS_DEFAULT_MODEL=llama3.2
NEXUS_OLLAMA_BASE_URL=http://localhost:11434

# Model Router — strategy and tier-to-backend mapping
NEXUS_ROUTING_STRATEGY=rule_based        # rule_based | passthrough
NEXUS_ROUTING_TIER_BYPASS=dev_backend    # deterministic ops — no LLM call
NEXUS_ROUTING_TIER_LIGHT=ollama          # fast / cheap model
NEXUS_ROUTING_TIER_STANDARD=ollama       # default model
NEXUS_ROUTING_TIER_HEAVY=ollama          # most capable model

# Voice Input Module
NEXUS_VOICE_ENABLED=false
NEXUS_VOICE_PROVIDER=dev                 # dev | http | whisper | openai
NEXUS_VOICE_ACTIVATION_MODE=manual       # manual | push_to_talk | always_listening
NEXUS_VOICE_SAMPLE_RATE=16000
NEXUS_VOICE_CHANNELS=1
NEXUS_VOICE_MAX_RECORD_SECONDS=10.0
NEXUS_VOICE_STT_ENDPOINT=http://localhost:8000/v1/audio/transcriptions
NEXUS_VOICE_STT_MODEL=whisper-1
NEXUS_VOICE_LANGUAGE=en
NEXUS_VOICE_AUTO_DISPATCH=true
